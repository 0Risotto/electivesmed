# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=

# SMTP (provider you control, e.g. Gmail app password, Zoho, Fastmail, custom)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Optional: reply/bounce detection
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Optional overrides
EL_DB_PATH=data/electivesmed.db
EL_PROFILE_PATH=config/profile.yaml
EL_SETTINGS_PATH=config/settings.yaml
